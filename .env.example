# ==========================================
# Variables de entorno de Spinkiu
# Copia este archivo como ".env.local" (desarrollo) y configura los
# mismos valores en tu hosting de producción (ej. Vercel → Settings → Environment Variables).
# ==========================================

# --- Supabase (obtenlas en tu proyecto: Project Settings → API) ---

# Públicas (se exponen al navegador). Sin estas, la app funciona en "modo local" (datos solo en el dispositivo).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETA (solo servidor). NUNCA la expongas en el navegador ni la subas al repositorio.
# Se usa en las API routes (/api/invite y /api/v1/*) con privilegios de administrador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
